{
  "id": "ps5-wake",
  "name": "PlayStation 5 BT Wake",
  "version": "1.3.0",
  "min_harmony_version": "4.0.0",
  "author": "Harmony-NG Community",
  "description": "Wake PlayStation 4 and PlayStation 5 consoles over Bluetooth via DualSense/DualShock controller emulation",
  "homepage": "https://github.com/iranl/harmony-ng-plugins/tree/main/ps5-wake",
  "entrypoint": "bin/ps5_wake",
  "files": [
    "manifest.json",
    "bin/ps5_wake",
    "bin/ps5_page",
    "bin/ps5_wake_helper.sh"
  ],
  "device_definition": {
    "device_type": "ps5",
    "display_name": "PlayStation 5 (BT Wake)",
    "config_fields": [
      {
        "key": "host_mac",
        "label": "PS5 Bluetooth MAC Address",
        "type": "string",
        "placeholder": "AA:BB:CC:DD:EE:FF"
      },
      {
        "key": "controller_mac",
        "label": "Controller MAC to Spoof",
        "type": "string",
        "placeholder": "11:22:33:44:55:66"
      }
    ],
    "default_commands": [
      {
        "name": "PowerOn",
        "keyCode": "PLUGIN:ps5-wake:Wake"
      },
      {
        "name": "Wake",
        "keyCode": "PLUGIN:ps5-wake:Wake"
      }
    ]
  }
}