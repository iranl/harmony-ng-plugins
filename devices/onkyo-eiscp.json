{
  "schema": 1,
  "id": "onkyo-eiscp",
  "name": "Onkyo / Pioneer / Integra AV receiver",
  "manufacturer": "Onkyo",
  "model": "Network receiver (eISCP)",
  "category": "receiver",
  "icon": "receiver",
  "description": "Onkyo, Pioneer (2016 and later) and Integra network receivers over eISCP (TCP port 60128).",
  "transports": {
    "tcp": {
      "label": "eISCP (port 60128)",
      "default": true,
      "connection": {
        "netHost": "{{host}}",
        "netPort": 60128
      }
    },
    "ir": {
      "label": "Infrared (learn the codes later)"
    }
  },
  "setup": {
    "message": "Enter the receiver's IP address. To turn it on over the network, enable Network Standby on the receiver.",
    "fields": [
      {
        "key": "host",
        "label": "IP address",
        "type": "string",
        "required": true,
        "placeholder": "192.168.1.50"
      }
    ]
  },
