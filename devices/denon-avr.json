{
  "schema": 1,
  "id": "denon-avr",
  "name": "Denon / Marantz AV receiver",
  "manufacturer": "Denon",
  "model": "AVR-X / SR / NR (2016 and later)",
  "category": "receiver",
  "icon": "receiver",
  "description": "Network control of Denon and Marantz AV receivers over Telnet (port 23) or HTTP (port 8080).",
  "transports": {
    "tcp": {
      "label": "Telnet (port 23)",
      "default": true,
      "connection": {
        "netHost": "{{host}}",
        "netPort": 23
      }
    },
    "http": {
      "label": "HTTP (port 8080)",
      "connection": {
        "netHost": "{{host}}",
        "netPort": 8080
      }
    },
    "ir": {
      "label": "Infrared (learn the codes later)"
    }
  },
  "setup": {
    "message": "Enter the receiver's IP address. To turn it on over the network, set Network > Settings > Network Control to Always On on the receiver.",
    "fields": [
      {
        "key": "host",
        "label": "IP address",
        "type": "string",
        "required": true,
        "placeholder": "192.168.1.50"
      }
    ]
  },
  "commands": [
    {
      "name": "PowerOn",
      "transport": "tcp",
      "tcpPayload": "PWON\\r"
    },
    {
      "name": "PowerOff",
      "transport": "tcp",
      "tcpPayload": "PWSTANDBY\\r"
    },
    {
      "name": "VolumeUp",
      "transport": "tcp",
      "tcpPayload": "MVUP\\r"
    },
    {
      "name": "VolumeDown",
      "transport": "tcp",
      "tcpPayload": "MVDOWN\\r"
    },
    {
