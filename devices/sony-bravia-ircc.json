{
  "schema": 1,
  "id": "sony-bravia-ircc",
  "name": "Sony Bravia TV",
  "manufacturer": "Sony",
  "model": "Bravia (2013 and later)",
  "category": "tv",
  "icon": "tv",
  "description": "Sony Bravia TVs over IP control (IRCC remote codes and power, with a pre-shared key), or with the sony-bravia plugin.",
  "transports": {
    "plugin": {
      "label": "sony-bravia plugin (also Wake-on-LAN and text)",
      "id": "sony-bravia",
      "config": {
        "host": "{{host}}",
        "psk": "{{psk}}"
      },
      "default_commands": true
    },
    "http": {
      "label": "IP control (HTTP)",
      "default": true,
      "connection": {
        "netHost": "{{host}}",
        "netPort": 80,
        "httpHeaders": [
          {
            "name": "X-Auth-PSK",
            "value": "{{psk}}"
          }
        ]
      }
    },
    "ir": {
      "label": "Infrared (learn the codes later)"
    }
  },
  "setup": {
    "message": "On the TV, open Settings > Network > Home network > IP control: set Authentication to Normal and Pre-Shared Key, and enter a key. Turn on Remote start to power the TV on over the network.",
    "fields": [
      {
        "key": "host",
        "label": "IP address",
        "type": "string",
        "required": true,
        "placeholder": "192.168.1.50"
      },
      {
        "key": "psk",
        "label": "Pre-shared key",
        "type": "password",
        "required": true
      }
    ]
  },
  "commands": [
    {
      "name": "PowerOn",
      "transport": "http",
      "httpMethod": "POST",
      "httpPath": "/sony/system",
      "httpBody": "{\"method\":\"setPowerStatus\",\"id\":55,\"params\":[{\"status\":true}],\"version\":\"1.0\"}"
    },
    {
      "name": "PowerOff",
      "transport": "http",
      "httpMethod": "POST",
      "httpPath": "/sony/system",
      "httpBody": "{\"method\":\"setPowerStatus\",\"id\":55,\"params\":[{\"status\":false}],\"version\":\"1.0\"}"
    },
    {
      "name": "PowerToggle",
      "transport": "http",
      "httpMethod": "POST",
      "httpPath": "/sony/IRCC",
      "httpContentType": "text/xml; charset=UTF-8",
      "httpBody": "<?xml version=\"1.0\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"><s:Body><u:X_SendIRCC xmlns:u=\"urn:schemas-sony-com:service:IRCC:1\"><IRCCCode>AAAAAQAAAAEAAAAVAw==</IRCCCode></u:X_SendIRCC></s:Body></s:Envelope>",
      "httpHeaders": [
        {
          "name": "SOAPACTION",
          "value": "\"urn:schemas-sony-com:service:IRCC:1#X_SendIRCC\""
        }
      ]
    },
