{
  "id": "android-tv",
  "name": "Android TV / Google TV Remote (v2)",
  "version": "1.4.1",
  "author": "Harmony-NG Community",
  "description": "Control Android TV and Google TV devices over local network via Google TV Remote protocol v2 (TLS/PIN Pairing). PowerOn wakes a TV off the network with Wake-on-LAN.",
  "homepage": "https://github.com/iranl/harmony-ng-plugins/tree/main/android-tv",
  "entrypoint": "bin/android_tv",
  "requires_libs": [
    "libbearssl.so.0"
  ],
  "files": [
    "manifest.json",
    "bin/android_tv"
  ],
  "pairing": {
    "supported": true,
    "type": "pin_display",
    "title": "Pair Android TV",
    "button_label": "Pair with TV",
    "description": "Pairing is required for Android TV / Google TV protocol.",
    "host_label": "TV IP Address / Host",
    "instructions": "Make sure your TV is turned on and connected to the same local network.",
    "prompt": "Enter the 6-character code shown on your TV screen:",
    "pin_length": 6
  },
  "device_definition": {
    "device_type": "androidtv",
    "display_name": "Android TV / Google TV",
    "config_fields": [
      {
        "key": "host",
        "label": "Hostname / IP Address",
        "type": "string",
        "placeholder": "192.168.1.60"
      },
      {
        "key": "mac",
        "label": "MAC Address (optional, for Wake-on-LAN)",
        "type": "string",
        "placeholder": "learned while the TV is on"
      }
    ],
    "default_commands": [
      {
        "name": "PowerToggle",
        "keyCode": "PLUGIN:android-tv:PowerToggle"
      },
      {
        "name": "PowerOn",
        "keyCode": "PLUGIN:android-tv:PowerOn"
      },
      {
        "name": "PowerOff",
        "keyCode": "PLUGIN:android-tv:PowerOff"
      },
      {
        "name": "Connect",
        "keyCode": "PLUGIN:android-tv:Connect"
      },
      {
        "name": "Disconnect",
        "keyCode": "PLUGIN:android-tv:Disconnect"
      },
      {
        "name": "Home",
        "keyCode": "PLUGIN:android-tv:Home"
      },
      {
        "name": "Back",
        "keyCode": "PLUGIN:android-tv:Back"
      },
      {
        "name": "Select",
        "keyCode": "PLUGIN:android-tv:Select"
      },
      {
        "name": "DirectionUp",
        "keyCode": "PLUGIN:android-tv:Up"
      },
      {
        "name": "DirectionDown",
        "keyCode": "PLUGIN:android-tv:Down"
      },
      {
        "name": "DirectionLeft",
        "keyCode": "PLUGIN:android-tv:Left"
      },
      {
        "name": "DirectionRight",
