      },
      {
        "name": "Input",
        "keyCode": "PLUGIN:lg-webos:Input"
      },
      {
        "name": "HDMI 1",
        "keyCode": "PLUGIN:lg-webos:HDMI 1"
      },
      {
        "name": "HDMI 2",
        "keyCode": "PLUGIN:lg-webos:HDMI 2"
      },
      {
        "name": "HDMI 3",
        "keyCode": "PLUGIN:lg-webos:HDMI 3"
      },
      {
        "name": "HDMI 4",
        "keyCode": "PLUGIN:lg-webos:HDMI 4"
      },
      {
        "name": "Exit",
        "keyCode": "PLUGIN:lg-webos:Exit"
      },
      {
        "name": "Captions",
        "keyCode": "PLUGIN:lg-webos:Captions"
      },
      {
        "name": "Settings",
        "keyCode": "PLUGIN:lg-webos:QuickSettings"
      },
      {
        "name": "YouTube",
        "keyCode": "PLUGIN:lg-webos:app:youtube"
      },
      {
        "name": "Netflix",
        "keyCode": "PLUGIN:lg-webos:app:netflix"
      },
      {
        "name": "Prime Video",
        "keyCode": "PLUGIN:lg-webos:app:prime"
      },
      {
        "name": "Disney+",
        "keyCode": "PLUGIN:lg-webos:app:disney"
      },
      {
        "name": "Spotify",
        "keyCode": "PLUGIN:lg-webos:app:spotify"
      },
      {
        "name": "Live TV",
        "keyCode": "PLUGIN:lg-webos:app:livetv"
      }
    ]
  }
}
